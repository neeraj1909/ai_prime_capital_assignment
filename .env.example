# Required provider configuration
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-terra

# Explicit starting embedding hypothesis. Change both values together.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=2
OPENAI_TIMEOUT_SECONDS=30

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_prime_capital_documents
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT_SECONDS=10

# Upload and extraction limits
MAX_FILES_PER_REQUEST=10
MAX_FILE_BYTES=10485760
MAX_REQUEST_BYTES=52428800
MAX_EXTRACTED_CHARS=5000000
DOCX_MAX_ENTRIES=1000
DOCX_MAX_EXPANDED_BYTES=52428800
DOCX_MAX_COMPRESSION_RATIO=100

# Chunking
# Bump this version when chunk boundaries or chunking semantics change.
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
CHUNK_SCHEMA_VERSION=v1

# Retrieval and generation
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
MAX_QUESTION_CHARS=4000
MAX_ANSWER_TOKENS=800

# Logging
LOG_LEVEL=INFO
